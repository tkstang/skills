{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tkstang/skills/consensus-review/review.schema.json",
  "title": "Consensus review reply",
  "description": "A bounded review reply. Findings must refer to captured repository content or an external document anchor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope_token",
    "verdict",
    "summary",
    "findings",
    "questions",
    "limitations",
    "coverage",
    "inspected_context",
    "checks",
    "reviewer_identity"
  ],
  "properties": {
    "schema_version": { "const": "v1" },
    "scope_token": { "type": "string", "minLength": 1, "maxLength": 256 },
    "verdict": {
      "enum": ["pass", "changes_requested", "inconclusive"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/definitions/finding" }
    },
    "questions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "coverage": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "inspected_context": {
      "type": "array",
      "items": { "$ref": "#/definitions/inspectedContext" }
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/definitions/check" }
    },
    "reviewer_identity": { "$ref": "#/definitions/reviewerIdentity" }
  },
  "definitions": {
    "finding": {
      "description": "Supply exactly one of location or anchor. Use location for captured repository files and anchor only for an external document scope; never supply both or omit both.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "title",
        "claim",
        "evidence",
        "suggestion",
        "confidence"
      ],
      "properties": {
        "severity": {
          "enum": ["critical", "high", "medium", "low"]
        },
        "title": { "type": "string", "minLength": 1 },
        "location": {
          "$ref": "#/definitions/location"
        },
        "anchor": {
          "description": "An external document heading or other textual anchor. Mutually exclusive with location.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "claim": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "suggestion": { "type": "string", "minLength": 1 },
        "confidence": {
          "description": "Confidence in this individual finding, from 0 (least certain) to 1 (most certain).",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "oneOf": [
        { "required": ["location"], "not": { "required": ["anchor"] } },
        { "required": ["anchor"], "not": { "required": ["location"] } }
      ]
    },
    "location": {
      "description": "A location in a captured repository file. Mutually exclusive with an external document anchor.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line", "source_version"],
      "properties": {
        "path": {
          "description": "The exact repository-relative path from the selected review scope, using forward slashes. This is a literal path, not a shell expression; the host also checks membership in captured paths.",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[\\s\\S]+$",
          "not": {
            "anyOf": [{ "pattern": "^/" }, { "pattern": "(^|/)\\.\\.(/|$)" }]
          }
        },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "source_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "inspectedContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "source_version"],
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "source_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "not_run"] },
        "detail": { "type": "string" }
      }
    },
    "reviewerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "effort": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
