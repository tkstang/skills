{
  "name": "skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build-generated.ts",
    "build:check": "tsx scripts/build-generated.ts --check",
    "sync:transcript-core": "tsx scripts/build-generated.ts",
    "test": "pnpm run test:vitest",
    "test:vitest": "node scripts/run-vitest.mjs",
    "test:live-e2e": "CONSENSUS_LIVE_SUBMIT_E2E=1 node scripts/run-vitest.mjs tests/consensus/provider-cli/e2e/submit-live.e2e.test.ts",
    "type-check": "tsc --noEmit",
    "premerge": "pnpm run build && pnpm run type-check && pnpm run build:check && pnpm run test && pnpm run validate && pnpm run smoke",
    "validate": "tsx scripts/validate.ts",
    "validate:skill-versions": "tsx scripts/validate-skill-versions.ts",
    "validate:internal-flags": "tsx scripts/validate-internal-flags.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "worktree:init": "bash scripts/worktree/init.sh",
    "worktree:validate": "bash scripts/worktree/validate.sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "hooks": "node tools/git-hooks/manage-hooks.mjs",
    "hooks:status": "node tools/git-hooks/manage-hooks.mjs status",
    "hooks:enable-all": "node tools/git-hooks/manage-hooks.mjs enable-all",
    "hooks:disable-all": "node tools/git-hooks/manage-hooks.mjs disable-all",
    "prepare": "test \"$GIT_HOOKS\" = \"0\" && exit 0; node tools/git-hooks/manage-hooks.mjs setup 2>/dev/null || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@types/node": "^22.19.21",
    "esbuild": "^0.28.1",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.69.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.13.1"
  },
  "packageManager": "pnpm@10.13.1"
}
