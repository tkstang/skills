{
  "version": 1,
  "projects": {
    "root": ".oat/projects/shared",
    "defaultScope": "shared"
  },
  "archive": {
    "s3Uri": "s3://tkstang-open-agent-toolkit/repositories",
    "s3SyncOnComplete": true,
    "summaryExportPath": ".oat/repo/reference/project-summaries",
    "awsProfile": "tkstang-artifact-sync",
    "awsRegion": "us-east-1"
  },
  "tools": {
    "core": false,
    "brainstorm": false
  },
  "pjm": {
    "initialized": true,
    "schemaVersion": 1
  },
  "documentation": {
    "root": "documentation",
    "tooling": "fumadocs",
    "index": "documentation/index.md"
  },
  "localPaths": [
    ".oat/**/analysis",
    ".oat/**/pr",
    ".oat/**/reviews/archived",
    ".oat/ideas",
    ".oat/projects/**/pr",
    ".oat/projects/**/reviews/archived",
    ".oat/projects/archived",
    ".oat/projects/local"
  ],
  "workflow": {
    "hillCheckpointDefault": "final",
    "archiveOnComplete": true,
    "postImplementSequence": {
      "preApproval": [
        "summary",
        "document",
        "pr"
      ],
      "postApproval": []
    },
    "autoReviewAtHillCheckpoints": true,
    "gates": {
      "execTargets": {
        "cursor-gpt-5-6-sol-xhigh": null,
        "cursor-opus-5-5-high": null,
        "cursor-fable-5-1-xhigh": null,
        "cursor-fable-5-1-high": null,
        "cursor-default": null
      }
    },
    "retro": {
      "filing": {
        "repo": "backlog",
        "upstream": "issues"
      },
      "apply": "ask",
      "upstreamRepo": "voxmedia/open-agent-toolkit"
    }
  }
}
