{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "eslint/prefer-const": "error",
    "eslint/eqeqeq": ["error", "smart"],
    "eslint/no-empty": "error",
    "eslint/no-underscore-dangle": "off",
    "eslint/no-shadow": "warn",
    "unicorn/consistent-function-scoping": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.mjs", "**/*.test.js", "tests/**"],
      "rules": {
        "eslint/no-unused-vars": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    ".oat/",
    ".agents/",
    ".claude/skills/**",
    ".cursor/skills/**",
    "dist/",
    "build/",
    "coverage/",
    "plugins/consensus/scripts/consensus-loop.mjs",
    "plugins/consensus/scripts/consensus.mjs",
    "tools/coding-session-handoff/coding-session-handoff.mjs",
    "plugins/consensus/skills/create/**",
    "plugins/consensus/skills/decide/**",
    "plugins/consensus/skills/evaluate/**",
    "plugins/consensus/skills/panel/**",
    "plugins/consensus/skills/phone-a-friend/**",
    "plugins/consensus/skills/plan/**",
    "plugins/consensus/skills/refine/**",
    "skills/complexity-review/**",
    "skills/must-we/**",
    "skills/next-steps/**",
    "skills/session-observer/**",
    "skills/session-observer-collab/**",
    "skills/session-export-transcript/**",
    "skills/session-fork-to-destination/**",
    "skills/session-retro/**",
    "plugins/consensus/skills/observer/**",
    "plugins/consensus/skills/observer-collab/**",
    "plugins/session/skills/export-transcript/**",
    "plugins/session/skills/fork-to-destination/**",
    "skills/session-handoff/**",
    "plugins/session/skills/handoff/**",
    "plugins/session/skills/retro/**"
  ]
}
