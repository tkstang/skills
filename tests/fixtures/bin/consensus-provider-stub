#!/usr/bin/env node

import { spawn } from 'node:child_process';
import { writeFileSync } from 'node:fs';

process.stdin.setEncoding('utf8');

let stdin = '';
process.stdin.on('data', (chunk) => {
  stdin += chunk;
});
process.stdin.on('end', () => {
  const [mode, ...args] = process.argv.slice(2);

  if (mode === 'echo-stdin') {
    process.stdout.write(stdin);
    return;
  }

  if (mode === 'stdout-stderr') {
    process.stdout.write('stdout text');
    process.stderr.write('stderr text');
    return;
  }

  if (mode === 'exit-code') {
    process.stderr.write('provider failed');
    process.exitCode = 7;
    return;
  }

  if (mode === 'sleep') {
    setTimeout(() => {
      process.stdout.write('late output');
    }, Number(args[0] ?? 1000));
    return;
  }

  if (mode === 'ignore-sigterm') {
    process.on('SIGTERM', () => {});
    setInterval(() => {}, 1000);
    return;
  }

  if (mode === 'ignore-sigterm-output') {
    process.on('SIGTERM', () => {});
    process.stdout.on('error', () => {});
    process.stderr.on('error', () => {});
    const chunk = 'x'.repeat(Number(args[0] ?? 1024));
    setInterval(() => {
      process.stdout.write(chunk);
      process.stderr.write(chunk);
    }, 1);
    return;
  }

  if (mode === 'big-output') {
    process.stdout.write('x'.repeat(Number(args[0] ?? 1024)));
    return;
  }

  if (mode === 'last-message') {
    const [outputPath] = args;
    if (!outputPath) {
      process.stderr.write('missing output path');
      process.exitCode = 64;
      return;
    }
    writeFileSync(outputPath, '{"verdict":"accept"}\n');
    process.stdout.write(
      '{"type":"session.started"}\n{"type":"turn.completed"}\n',
    );
    return;
  }

  if (mode === 'last-message-sized') {
    const [outputPath, size] = args;
    if (!outputPath) {
      process.stderr.write('missing output path');
      process.exitCode = 64;
      return;
    }
    writeFileSync(outputPath, 'x'.repeat(Number(size ?? 1024)));
    return;
  }

  // Process-group fixtures. The grandchild ignores SIGTERM and does not hold
  // this process's stdio, so only a signal to the whole group can stop it.
  // The leader prints `grandchild:<pid>` once the grandchild's trap is set,
  // then waits for SIGTERM (`wait`), floods output (`flood`), or exits (`exit`).
  if (mode === 'sigterm-grandchild') {
    const grandchild = spawn(
      '/bin/sh',
      ['-c', 'trap "" TERM; echo ready; exec sleep 30'],
      { stdio: ['ignore', 'pipe', 'ignore'] },
    );
    grandchild.stdout.once('data', () => {
      process.stdout.write(`grandchild:${grandchild.pid}\n`);
      if (args[0] === 'flood') {
        process.stdout.on('error', () => {});
        const chunk = 'x'.repeat(4096);
        setInterval(() => process.stdout.write(chunk), 1);
        return;
      }
      if (args[0] === 'exit') {
        grandchild.stdout.destroy();
        grandchild.unref();
        return;
      }
      setInterval(() => {}, 1000);
    });
    return;
  }

  // A grandchild in its own process group keeps this process's stdout and
  // stderr open after the leader exits, so the leader's group is already gone
  // (ESRCH) when the runner signals it.
  if (mode === 'escaped-grandchild') {
    const grandchild = spawn(
      process.execPath,
      ['-e', 'setTimeout(() => {}, 10000)'],
      { detached: true, stdio: ['ignore', 'inherit', 'inherit'] },
    );
    process.stdout.write(`grandchild:${grandchild.pid}\n`);
    grandchild.unref();
    return;
  }

  // A SIGTERM-ignoring leader whose grandchild, in another process group,
  // holds the output pipes: group SIGKILL ends the leader, but the pipes stay
  // open, so only the bounded settlement can end the run.
  if (mode === 'escaped-grandchild-holds-pipes') {
    process.on('SIGTERM', () => {});
    const grandchild = spawn(
      process.execPath,
      ['-e', 'setTimeout(() => {}, 10000)'],
      { detached: true, stdio: ['ignore', 'inherit', 'inherit'] },
    );
    process.stdout.write(`grandchild:${grandchild.pid}\n`);
    grandchild.unref();
    setInterval(() => {}, 1000);
    return;
  }

  if (mode === 'argv-json') {
    process.stdout.write(JSON.stringify(args));
    return;
  }

  process.stderr.write(`unknown mode: ${mode ?? ''}`);
  process.exitCode = 64;
});
