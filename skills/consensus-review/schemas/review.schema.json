{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/tkstang/skills/consensus-review/review.schema.json",
  "title": "Consensus review reply",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope_token",
    "verdict",
    "summary",
    "findings",
    "questions",
    "limitations",
    "coverage",
    "inspected_context",
    "checks",
    "reviewer_identity"
  ],
  "properties": {
    "schema_version": { "const": "v1" },
    "scope_token": { "type": "string", "minLength": 1, "maxLength": 256 },
    "verdict": {
      "enum": ["pass", "changes_requested", "inconclusive"]
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 8192 },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/definitions/finding" }
    },
    "questions": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "limitations": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "coverage": {
      "type": "array",
      "maxItems": 200,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "inspected_context": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/definitions/inspectedContext" }
    },
    "checks": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/definitions/check" }
    },
    "reviewer_identity": { "$ref": "#/definitions/reviewerIdentity" }
  },
  "definitions": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "title",
        "claim",
        "evidence",
        "suggestion",
        "confidence"
      ],
      "properties": {
        "severity": {
          "enum": ["critical", "high", "medium", "low"]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "location": { "$ref": "#/definitions/location" },
        "anchor": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "claim": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "suggestion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "oneOf": [
        { "required": ["location"], "not": { "required": ["anchor"] } },
        { "required": ["anchor"], "not": { "required": ["location"] } }
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line", "source_version"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
        },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 },
        "source_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "inspectedContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "source_version"],
      "properties": {
        "subject": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "source_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 512 },
        "status": { "enum": ["passed", "failed", "not_run"] },
        "detail": { "type": "string", "maxLength": 4096 }
      }
    },
    "reviewerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "maxLength": 128 },
        "model": { "type": "string", "minLength": 1, "maxLength": 256 },
        "effort": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
